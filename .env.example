# ============================================================
# Variables de entorno — AVSA Backend
# ============================================================
# Copiar este archivo a .env y ajustar valores si es necesario

# ── Servidor ────────────────────────────────────────────────
PORT=8085
SERVER_URL=http://localhost:8085

# ── Base de datos ───────────────────────────────────────────
DATABASE_URL=jdbc:sqlserver://localhost:1433;databaseName=avsa_db;encrypt=false;trustServerCertificate=true
DATABASE_USERNAME=sa
DATABASE_PASSWORD=Admin12345!!
DATABASE_DRIVER=com.microsoft.sqlserver.jdbc.SQLServerDriver
